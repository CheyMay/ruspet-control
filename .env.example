# Local demo only. Do not expose demo login to the internet.
PORT=4310
HOST=127.0.0.1
DEMO_AUTH=true
TASK_PROVIDER=mock
TELEGRAM_MODE=mock
# npm run dev creates a private local PostgreSQL cluster automatically.
# For your own PostgreSQL, uncomment and set a connection string:
# DATABASE_URL=postgresql://ruspet:CHANGE_ME@127.0.0.1:5432/ruspet

# Optional HTTPS forwarding bridge for Telegram JSON calls and PDF uploads.
# Store the secret and bot token in private files outside Git.
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_SECRET_FILE=
# TELEGRAM_BOT_TOKEN_FILE=/opt/ruspet/.secrets/telegram-token

# Bitrix: private files only, never paste webhook URLs into Git or command lines.
BITRIX_PORTAL=thebest.bitrix24.ru
BITRIX_WEBHOOK_FILE=
BITRIX_EVENTS_ENABLED=false
BITRIX_EVENT_TOKEN_FILE=

# Enable only on the single Bitrix worker after mapping and initial reconciliation.
BITRIX_WRITE_ENABLED=false

# Initial bootstrap/catchup first. All new incoming tasks use the webhook user visibility.
BITRIX_IMPORT_NEW_ENABLED=false
BITRIX_CREATE_ENABLED=false

# Task content, discussions, checklists, files, results and history (single Bitrix worker).
BITRIX_CONTENT_ENABLED=false
# A real writable Bitrix Disk folder ID is required to upload files.
BITRIX_UPLOAD_FOLDER_ID=
# Optional exact trusted download hosts, comma-separated. Portal itself is allowed.
BITRIX_FILE_HOSTS=
# Enable ONLY for a dedicated Bitrix integration user: IM offsets consume a shared per-user queue.
BITRIX_IM_EVENTS_EXCLUSIVE=false
# Bounded changed-task reconciliation every 30 minutes, to recover lost task webhooks.
BITRIX_RECONCILE_ENABLED=false
