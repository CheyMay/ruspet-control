# Local demo only. Do not expose demo login to the internet.
PORT=4310
HOST=127.0.0.1
DEMO_AUTH=true
TASK_PROVIDER=mock
TELEGRAM_MODE=mock
# npm run dev creates a private local PostgreSQL cluster automatically.
# For your own PostgreSQL, uncomment and set a connection string:
# DATABASE_URL=postgresql://ruspet:CHANGE_ME@127.0.0.1:5432/ruspet

# Optional HTTPS forwarding bridge for Telegram JSON calls and PDF uploads.
# Store the secret and bot token in private files outside Git.
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_SECRET_FILE=
# TELEGRAM_BOT_TOKEN_FILE=/opt/ruspet/.secrets/telegram-token

# Controlled Bitrix pilot: credentials stay in a private file, never in this URL.
# BITRIX_PORTAL=thebest.bitrix24.ru
# BITRIX_WEBHOOK_FILE=/opt/ruspet/.secrets/bitrix-webhook
# Explicit worker-side gate; the DB pilot switch must also be enabled.
BITRIX_WRITE_ENABLED=false
# Use legacy comments only after checking the actual portal's card format.
BITRIX_LEGACY_COMMENTS=false

# Optional central Bitrix balancer; URLs/keys live only in the private JSON file.
# BITRIX_TRANSPORT=balancer
# BITRIX_BALANCER_CONFIG_FILE=/opt/ruspet/.secrets/bitrix-balancer.json
# BITRIX_BALANCER_TIMEOUT_MS=60000
